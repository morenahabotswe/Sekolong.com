import React,{useState} from 'react';
import {Auth} from './components/Auth';
import {Mosuoe} from './components/Mosuoe';
import {Shell} from './components/Shell';
import {
  AdminDashboard,
  SettingsPage,
  StudentClassesPage,
  StudentDashboard,
  StudentLearnPage,
  StudentProfilePage,
  StudentResourcesPage,
  TeacherDashboard,
  TeacherStudentsPage,
} from './components/Dashboards';
import type {User} from './types';

export default function App(){
  const [user,setUser]=useState<User|null>(null);
  const [view,setView]=useState('home');

  const handleLogout=()=>setUser(null);
  const handleMosuoe=()=>setView('mosuoe');

  if(!user) return <Auth onLogin={setUser}/>;

  const commonProps={user,onNavigate:setView,onMosuoe:handleMosuoe};

  const renderStudentView=()=>{
    switch(view){
      case 'learn': return <StudentLearnPage {...commonProps}/>;
      case 'classes': return <StudentClassesPage {...commonProps}/>;
      case 'profile': return <StudentProfilePage {...commonProps}/>;
      case 'resources': return <StudentResourcesPage {...commonProps}/>;
      case 'mosuoe': return <Mosuoe user={user} onBack={()=>setView('home')}/>;
      default: return <StudentDashboard {...commonProps}/>;
    }
  };

  const renderTeacherView=()=>{
    switch(view){
      case 'students': return <TeacherStudentsPage user={user} onNavigate={setView}/>;
      case 'settings': return <SettingsPage user={user} onNavigate={setView}/>;
      default: return <TeacherDashboard user={user} onNavigate={setView} onMosuoe={handleMosuoe}/>;
    }
  };

  const renderAdminView=()=>{
    switch(view){
      case 'settings': return <SettingsPage user={user} onNavigate={setView}/>;
      default: return <AdminDashboard user={user} onNavigate={setView} onMosuoe={handleMosuoe}/>;
    }
  };

  return (
    <Shell
      user={user}
      currentView={view}
      onNavigate={setView}
      onLogout={handleLogout}
      onMosuoe={handleMosuoe}
    >
      {user.role==='student'&&renderStudentView()}
      {user.role==='teacher'&&renderTeacherView()}
      {user.role==='admin'&&renderAdminView()}
    </Shell>
  );
}
